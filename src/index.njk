</section>

{# CTA Section #}
<section class="section" style="background-color: var(--color-primary); color: var(--color-white);">
  <div class="section__inner text-center">
    <h2 class="section__title" style="color: var(--color-white);">Prêt à commencer ?</h2>
    <p class="section__description" style="color: var(--color-secondary-light);">
      Rejoignez-nous pour un cours d'essai gratuit et découvrez les bienfaits du Tai Chi Chuan.
    </p>
    <div class="mt-lg">
      <a href="/contact/" class="button button--secondary">Nous contacter</a>
    </div>
  </div>

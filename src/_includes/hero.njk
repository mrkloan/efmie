<section class="hero" aria-labelledby="hero-title">
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__title-main">{{ title | default("Tai Chi Chuan") }}</span>
      <span class="hero__title-sub">{{ subtitle | default("à Neuilly-sur-Seine") }}</span>
    </h1>
    
    {% if description %}
    <p class="hero__description">{{ description }}</p>
    {% endif %}
    
    {% if cta %}
    <div class="hero__cta">
      {% for item in cta %}
      <a href="{{ item.url }}" class="button button--{{ item.style | default("primary") }}">{{ item.text }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  
  {% if background %}
  <div class="hero__background" style="--bg-image: url('{{ background }}')"></div>
  {% endif %}
</section>
